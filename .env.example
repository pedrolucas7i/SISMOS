# ============================================================
# ATerraTreme — Environment Variables
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Application version used in the HTTP User-Agent.
APP_VERSION=1.0

# Must match Coolify's injected PORT.
# Dockerfile pack defaults to 3000.
PORT=3000


# ------------------------------------------------------------
# Discord
# ------------------------------------------------------------

# Optional — Discord alerts.
# The web UI works without this.
DISCORD_WEBHOOK_URL=


# ------------------------------------------------------------
# Firebase Cloud Messaging
# ------------------------------------------------------------

# Optional — leave empty to disable mobile push notifications.
# Mount the service-account JSON into the container; do not bake it into the image.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_TOPIC=todos


# ------------------------------------------------------------
# Map / Tile Provider
# ------------------------------------------------------------

# Primary tile provider.
#
# osm      = OpenStreetMap
# cartodb  = CartoDB Voyager
#
# Recommended:
MAP_PROVIDER=osm

# Map zoom used when generating earthquake images.
# Keep this moderate to avoid unnecessary tile requests.
MAP_ZOOM=8

# Maximum time, in seconds, to wait for map tiles.
MAP_TIMEOUT=12


# ------------------------------------------------------------
# HTTP identity for tile providers
# ------------------------------------------------------------

# IMPORTANT:
# Use your real public application URL.
#
# The application should identify itself to tile providers.
MAP_USER_AGENT=SismoBot/1.0 (+https://your-domain.example)

# Public URL of your application.
# Replace with your real domain.
MAP_REFERER=https://your-domain.example/


# ------------------------------------------------------------
# Tile cache
# ------------------------------------------------------------

# Persistent cache directory for downloaded map tiles.
#
# On Coolify, preferably mount a persistent volume at /data
# and use:
#
# TILE_CACHE_DIR=/data/tile-cache
#
# If no persistent volume is configured, this fallback uses
# the container's temporary filesystem.
TILE_CACHE_DIR=/tmp/aterratreme-tile-cache